{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🔄 切換到根因分析Agent",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/root_cause_agent.py"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🎯 分析當前文件",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/root_cause_agent.py",
        "analyze",
        "--file",
        "${file}"
      ],
      "group": "test"
    },
    {
      "label": "📊 運行演示",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/root_cause_agent.py",
        "demo"
      ],
      "group": "test"
    }
  ]
}